# Required for sign-in. Add all three to the Vercel deployment environment.
# HTTPS canonical origin in production; no /login or /auth/callback suffix.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key beginning sb_publishable_; never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only repository integration. These do not gate GitHub OAuth sign-in.
SUPABASE_SECRET_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Quoted PEM with escaped \n or a multiline hosting-provider secret.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Server-only scheduled execution expiry and private artifact cleanup.
CRON_SECRET=

# Only controls the initial /demo dataset. Does not bypass /app authentication.
NEXT_PUBLIC_DEMO_MODE=true

# Optional server-only AI; no key is needed for fix prompts or ordinary testing.
OPENAI_API_KEY=
FLOWGUARD_AI_MODEL=gpt-5.4-mini
# Required when changing the model; standard per-million-token USD prices.
# FLOWGUARD_AI_INPUT_USD_PER_MILLION=0.75
# FLOWGUARD_AI_OUTPUT_USD_PER_MILLION=4.5

# Optional Sentry project DSNs. Leave blank to disable outbound monitoring.
# NEXT_PUBLIC_SENTRY_DSN is a public ingestion identifier, never an API token.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
