# Canonical origin. Use the same hostname in browser, cookies and OAuth.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Supabase → Connect / API keys. Publishable key only; never a secret here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: verified installation metadata and signature-verified webhooks.
# User CRUD always uses the user's session and RLS.
SUPABASE_SECRET_KEY=

# Separate GitHub App, not the OAuth App credentials used by Supabase.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Quoted PEM with escaped \n is supported, as are actual multiline secrets.
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Only chooses the initial /demo dataset; never bypasses /app authentication.
NEXT_PUBLIC_DEMO_MODE=true
