{
  "name": "flowguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:server": "node --conditions=react-server --import tsx --test tests/server/*.test.ts",
    "test:security": "node --import tsx --test tests/security/*.test.ts",
    "test:integration": "playwright test --config playwright.integration.config.ts",
    "test:runner": "node --import tsx --test tests/runner/*.test.ts",
    "runner:build": "npm --prefix packages/runner run build"
  },
  "dependencies": {
    "@sentry/nextjs": "11.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "ipaddr.js": "2.2.0",
    "lucide-react": "^1.62.0",
    "next": "16.4.3",
    "octokit": "5.0.5",
    "openai": "7.45.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "0.5.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fflate": "0.8.3",
    "prettier": "^3.9.10",
    "supabase": "2.122.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "type": "module"
}
